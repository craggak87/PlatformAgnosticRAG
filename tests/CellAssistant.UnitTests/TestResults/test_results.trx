[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           document.addEventListener('keydown', (e) =&gt; {
[xUnit.net 00:00:01.08]             if (e.key === 'Escape') this.closeModal();
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         switchTab(tab) {
[xUnit.net 00:00:01.08]           this.state.currentTab = tab;
[xUnit.net 00:00:01.08]           const tabChat = document.getElementById('tabChat');
[xUnit.net 00:00:01.08]           const tabAdmin = document.getElementById('tabAdmin');
[xUnit.net 00:00:01.08]           const viewChat = document.getElementById('chatView');
[xUnit.net 00:00:01.08]           const viewAdmin = document.getElementById('adminView');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           if (tab === 'chat') {
[xUnit.net 00:00:01.08]             tabChat.classList.add('active');
[xUnit.net 00:00:01.08]             tabAdmin.classList.remove('active');
[xUnit.net 00:00:01.08]             viewChat.classList.add('active');
[xUnit.net 00:00:01.08]             viewAdmin.classList.remove('active');
[xUnit.net 00:00:01.08]           } else {
