[xUnit.net 00:00:01.07]             const headers = rows[0].split('|').filter(c =&gt; c.trim() !== '');
[xUnit.net 00:00:01.07]             html += '&lt;tr&gt;' + headers.map(h =&gt; `&lt;th&gt;${h.trim()}&lt;/th&gt;`).join('') + '&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;';
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]             // Skip row 1 (table header separator |---|---|)
