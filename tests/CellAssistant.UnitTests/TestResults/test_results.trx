[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Admin Dashboard Controls
[xUnit.net 00:00:01.08]           document.getElementById('refreshAdminBtn').addEventListener('click', () =&gt; this.loadAdminMetrics());
[xUnit.net 00:00:01.08]           document.getElementById('reindexBtn').addEventListener('click', () =&gt; this.triggerReindex());
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Document Viewer Modal Close
[xUnit.net 00:00:01.08]           document.getElementById('modalCloseBtn').addEventListener('click', () =&gt; this.closeModal());
[xUnit.net 00:00:01.08]           document.getElementById('docViewerModal').addEventListener('click', (e) =&gt; {
