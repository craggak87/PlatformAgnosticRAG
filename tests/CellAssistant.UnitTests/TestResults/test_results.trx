            &lt;svg viewBox="0 0 24 24" class="svg-icon-brand"&gt;&lt;path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/&gt;&lt;/svg&gt;
          &lt;/div&gt;
          &lt;div class="brand-text"&gt;
            &lt;span class="brand-title"&gt;Cell Knowledge Assistant&lt;/span&gt;
            &lt;span class="brand-subtitle"&gt;Manufacturing Intelligence &amp; Retrieval&lt;/span&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;nav class="header-nav"&gt;
        &lt;button id="tabChat" class="nav-tab active"&gt;
          &lt;svg viewBox="0 0 24 24" class="svg-icon-tab"&gt;&lt;path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/&gt;&lt;/svg&gt;
          &lt;span&gt;Chat Assistant&lt;/span&gt;
        &lt;/button&gt;
        &lt;button id="tabAdmin" class="nav-tab"&gt;
          &lt;svg viewBox="0 0 24 24" class="svg-icon-tab"&gt;&lt;path d="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65A.488.488 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"/&gt;&lt;/svg&gt;
          &lt;span&gt;Admin Dashboard&lt;/span&gt;
        &lt;/button&gt;
      &lt;/nav&gt;

      &lt;div class="header-right"&gt;
        &lt;div id="systemHealthBadge" class="health-pill" title="System Operational Status"&gt;
          &lt;span class="status-indicator-dot"&gt;&lt;/span&gt;
          &lt;span id="systemHealthText"&gt;Checking System...&lt;/span&gt;
        &lt;/div&gt;
        &lt;span class="mode-badge" title="ADR-002: 100% Offline Local Execution"&gt;Air-Gapped&lt;/span&gt;
      &lt;/div&gt;
    &lt;/header&gt;

    &lt;!-- App Body Grid --&gt;
    &lt;div class="app-body"&gt;
      &lt;!-- Search History Sidebar --&gt;
      &lt;aside id="historySidebar" class="sidebar"&gt;
        &lt;div class="sidebar-header"&gt;
          &lt;div class="sidebar-title"&gt;
            &lt;svg viewBox="0 0 24 24" class="svg-icon-sm"&gt;&lt;path d="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/&gt;&lt;/svg&gt;
            &lt;span&gt;Search History&lt;/span&gt;
          &lt;/div&gt;
          &lt;button id="newChatBtn" class="btn-sm btn-primary" title="Start new conversation"&gt;
            &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/&gt;&lt;/svg&gt;
            &lt;span&gt;New Chat&lt;/span&gt;
          &lt;/button&gt;
        &lt;/div&gt;

        &lt;div id="historyList" class="history-list"&gt;
          &lt;div class="history-empty"&gt;Loading recent searches...&lt;/div&gt;
        &lt;/div&gt;
      &lt;/aside&gt;

      &lt;!-- Main Workspace Viewport --&gt;
      &lt;main class="main-viewport"&gt;
        &lt;!-- 1. CHAT VIEW CONTAINER --&gt;
        &lt;section id="chatView" class="view-panel active chat-container"&gt;
          &lt;!-- Filter Controls Bar --&gt;
          &lt;div class="filter-bar"&gt;
            &lt;div class="filter-group"&gt;
              &lt;label for="equipmentFilter" class="filter-label"&gt;
                &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M22 18V3H2v15H0v2h24v-2h-2zm-8 0h-4v-1h4v1zm6-3H4V5h16v10z"/&gt;&lt;/svg&gt;
                &lt;span&gt;Equipment:&lt;/span&gt;
              &lt;/label&gt;
              &lt;select id="equipmentFilter" class="filter-select"&gt;
                &lt;option value=""&gt;All Equipment&lt;/option&gt;
                &lt;option value="ROBOT01"&gt;ROBOT01 (ABB IRB4600)&lt;/option&gt;
                &lt;option value="ROBOT02"&gt;ROBOT02 (ABB IRB2600)&lt;/option&gt;
                &lt;option value="PLC01"&gt;PLC01 (Siemens S7-1515F)&lt;/option&gt;
                &lt;option value="CONV01"&gt;CONV01 (Dorner Infeed)&lt;/option&gt;
                &lt;option value="VFD01"&gt;VFD01 (PowerFlex 525)&lt;/option&gt;
                &lt;option value="CAM01"&gt;CAM01 (Cognex In-Sight)&lt;/option&gt;
                &lt;option value="HMI01"&gt;HMI01 (Comfort Panel)&lt;/option&gt;
              &lt;/select&gt;
            &lt;/div&gt;

            &lt;div class="filter-group"&gt;
              &lt;label for="folderFilter" class="filter-label"&gt;
                &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/&gt;&lt;/svg&gt;
                &lt;span&gt;Vault Folder:&lt;/span&gt;
              &lt;/label&gt;
              &lt;select id="folderFilter" class="filter-select"&gt;
                &lt;option value=""&gt;All Folders&lt;/option&gt;
                &lt;option value="Equipment"&gt;Equipment&lt;/option&gt;
                &lt;option value="Faults"&gt;Faults&lt;/option&gt;
                &lt;option value="Alarms"&gt;Alarms&lt;/option&gt;
                &lt;option value="PLC"&gt;PLC&lt;/option&gt;
                &lt;option value="Robot"&gt;Robot&lt;/option&gt;
                &lt;option value="Vision"&gt;Vision&lt;/option&gt;
                &lt;option value="Safety"&gt;Safety&lt;/option&gt;
                &lt;option value="Electrical"&gt;Electrical&lt;/option&gt;
                &lt;option value="Pneumatics"&gt;Pneumatics&lt;/option&gt;
                &lt;option value="Mechanical"&gt;Mechanical&lt;/option&gt;
                &lt;option value="Maintenance"&gt;Maintenance&lt;/option&gt;
                &lt;option value="Procedures"&gt;Procedures&lt;/option&gt;
                &lt;option value="Improvements"&gt;Improvements&lt;/option&gt;
                &lt;option value="Lessons-Learned"&gt;Lessons-Learned&lt;/option&gt;
                &lt;option value="Drawings"&gt;Drawings&lt;/option&gt;
                &lt;option value="Manuals"&gt;Manuals&lt;/option&gt;
              &lt;/select&gt;
            &lt;/div&gt;

            &lt;button id="clearFiltersBtn" class="btn-text btn-xs" title="Reset filters"&gt;Reset Filters&lt;/button&gt;
          &lt;/div&gt;

          &lt;!-- Chat Messages Container --&gt;
          &lt;div id="messagesContainer" class="messages-container"&gt;
            &lt;!-- Empty State / Welcome Screen --&gt;
            &lt;div id="emptyState" class="empty-state"&gt;
              &lt;div class="empty-state-icon"&gt;
                &lt;svg viewBox="0 0 24 24" class="svg-icon-hero"&gt;&lt;path d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z"/&gt;&lt;/svg&gt;
              &lt;/div&gt;
              &lt;h2 class="empty-state-title"&gt;Industrial Knowledge Assistant&lt;/h2&gt;
              &lt;p class="empty-state-desc"&gt;Ask natural language or diagnostic questions against cell SOPs, manuals, PLC code logic, and electrical schematics.&lt;/p&gt;
              
              &lt;div class="prompt-chips"&gt;
                &lt;button class="chip" data-query="What causes gripper timeout?"&gt;
                  &lt;span class="chip-query"&gt;"What causes gripper timeout?"&lt;/span&gt;
                  &lt;span class="chip-tag"&gt;FLT-002 / ROBOT01&lt;/span&gt;
                &lt;/button&gt;
                &lt;button class="chip" data-query="What causes alarm ALM-205?"&gt;
                  &lt;span class="chip-query"&gt;"What causes alarm ALM-205?"&lt;/span&gt;
                  &lt;span class="chip-tag"&gt;ALM-205 / CONV01&lt;/span&gt;
                &lt;/button&gt;
                &lt;button class="chip" data-query="What inputs are used for Safety Gate 2 interlocks?"&gt;
                  &lt;span class="chip-query"&gt;"What inputs are used for Safety Gate 2 interlocks?"&lt;/span&gt;
                  &lt;span class="chip-tag"&gt;PLC01 / Safety&lt;/span&gt;
                &lt;/button&gt;
                &lt;button class="chip" data-query="How to reset conveyor drive overload on VFD01?"&gt;
                  &lt;span class="chip-query"&gt;"How to reset conveyor drive overload on VFD01?"&lt;/span&gt;
                  &lt;span class="chip-tag"&gt;VFD01 / Faults&lt;/span&gt;
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;!-- Message Input Bar --&gt;
          &lt;div class="input-section"&gt;
            &lt;form id="queryForm" class="query-form"&gt;
              &lt;div class="input-wrapper"&gt;
                &lt;textarea id="queryInput" class="query-textarea" placeholder="Type a manufacturing question (e.g. What causes gripper timeout?)..." rows="1" maxlength="2000"&gt;&lt;/textarea&gt;
                &lt;div class="input-actions"&gt;
                  &lt;span id="charCounter" class="char-counter"&gt;0 / 2000&lt;/span&gt;
                  &lt;button type="button" id="stopStreamBtn" class="btn-stop hidden" title="Cancel Streaming"&gt;
                    &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M6 6h12v12H6z"/&gt;&lt;/svg&gt;
                    &lt;span&gt;Stop&lt;/span&gt;
                  &lt;/button&gt;
                  &lt;button type="submit" id="sendBtn" class="btn-send" title="Send Question (Enter)"&gt;
                    &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/&gt;&lt;/svg&gt;
                    &lt;span&gt;Send&lt;/span&gt;
                  &lt;/button&gt;
                &lt;/div&gt;
              &lt;/div&gt;
              &lt;div class="input-hint"&gt;
                &lt;span&gt;Press &lt;strong&gt;Enter&lt;/strong&gt; to send, &lt;strong&gt;Shift+Enter&lt;/strong&gt; for newline&lt;/span&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/section&gt;

        &lt;!-- 2. ADMIN DASHBOARD VIEW CONTAINER --&gt;
        &lt;section id="adminView" class="view-panel admin-container"&gt;
          &lt;div class="admin-header"&gt;
            &lt;div&gt;
              &lt;h2 class="admin-title"&gt;System Administration &amp; Knowledge Vault Status&lt;/h2&gt;
              &lt;p class="admin-subtitle"&gt;Real-time health telemetry, persistence metrics, and indexer reconciliation control.&lt;/p&gt;
            &lt;/div&gt;
            &lt;button id="refreshAdminBtn" class="btn btn-secondary"&gt;
              &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/&gt;&lt;/svg&gt;
              &lt;span&gt;Refresh Status&lt;/span&gt;
            &lt;/button&gt;
          &lt;/div&gt;

          &lt;!-- Top Metrics Tiles --&gt;
          &lt;div class="metrics-grid"&gt;
            &lt;div class="metric-card"&gt;
              &lt;div class="metric-icon metric-icon-blue"&gt;
                &lt;svg viewBox="0 0 24 24" class="svg-icon-metric"&gt;&lt;path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/&gt;&lt;/svg&gt;
              &lt;/div&gt;
              &lt;div class="metric-body"&gt;
                &lt;div class="metric-label"&gt;Indexed Documents&lt;/div&gt;
                &lt;div id="metricDocCount" class="metric-value"&gt;--&lt;/div&gt;
                &lt;div class="metric-meta"&gt;SQLite Vault Registry&lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div class="metric-card"&gt;
              &lt;div class="metric-icon metric-icon-purple"&gt;
                &lt;svg viewBox="0 0 24 24" class="svg-icon-metric"&gt;&lt;path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/&gt;&lt;/svg&gt;
              &lt;/div&gt;
              &lt;div class="metric-body"&gt;
                &lt;div class="metric-label"&gt;Vector Embeddings&lt;/div&gt;
                &lt;div id="metricVectorCount" class="metric-value"&gt;--&lt;/div&gt;
                &lt;div class="metric-meta"&gt;Qdrant Collection: cell-knowledge&lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div class="metric-card"&gt;
              &lt;div class="metric-icon metric-icon-amber"&gt;
                &lt;svg viewBox="0 0 24 24" class="svg-icon-metric"&gt;&lt;path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/&gt;&lt;/svg&gt;
              &lt;/div&gt;
              &lt;div class="metric-body"&gt;
                &lt;div class="metric-label"&gt;Last Index Run&lt;/div&gt;
                &lt;div id="metricLastRun" class="metric-value"&gt;--&lt;/div&gt;
                &lt;div class="metric-meta"&gt;SHA-256 Hash Verification&lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div class="metric-card"&gt;
              &lt;div class="metric-icon metric-icon-green"&gt;
                &lt;svg viewBox="0 0 24 24" class="svg-icon-metric"&gt;&lt;path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/&gt;&lt;/svg&gt;
              &lt;/div&gt;
              &lt;div class="metric-body"&gt;
                &lt;div class="metric-label"&gt;Indexer State&lt;/div&gt;
                &lt;div id="metricIndexerState" class="metric-value"&gt;--&lt;/div&gt;
                &lt;div class="metric-meta"&gt;Background File Watcher&lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;!-- Subsystem Health Cards Grid --&gt;
          &lt;h3 class="section-heading"&gt;Subsystem Health Status&lt;/h3&gt;
          &lt;div class="health-grid"&gt;
            &lt;div id="healthCardApi" class="health-card"&gt;
              &lt;div class="health-card-header"&gt;
                &lt;span class="health-card-title"&gt;REST / SSE API Host&lt;/span&gt;
                &lt;span id="healthApiBadge" class="badge badge-secondary"&gt;Checking...&lt;/span&gt;
              &lt;/div&gt;
              &lt;div id="healthApiDesc" class="health-card-desc"&gt;ASP.NET Core Kestrel web host&lt;/div&gt;
            &lt;/div&gt;

            &lt;div id="healthCardOllama" class="health-card"&gt;
              &lt;div class="health-card-header"&gt;
                &lt;span class="health-card-title"&gt;Ollama LLM &amp; Embeddings&lt;/span&gt;
                &lt;span id="healthOllamaBadge" class="badge badge-secondary"&gt;Checking...&lt;/span&gt;
              &lt;/div&gt;
              &lt;div id="healthOllamaDesc" class="health-card-desc"&gt;gemma4:e4b-it-q4_K_M &amp; embeddinggemma-2:latest&lt;/div&gt;
            &lt;/div&gt;

            &lt;div id="healthCardQdrant" class="health-card"&gt;
              &lt;div class="health-card-header"&gt;
                &lt;span class="health-card-title"&gt;Qdrant Vector Database&lt;/span&gt;
                &lt;span id="healthQdrantBadge" class="badge badge-secondary"&gt;Checking...&lt;/span&gt;
              &lt;/div&gt;
              &lt;div id="healthQdrantDesc" class="health-card-desc"&gt;gRPC/REST port 6333, collection 'cell-knowledge'&lt;/div&gt;
            &lt;/div&gt;

            &lt;div id="healthCardSqlite" class="health-card"&gt;
              &lt;div class="health-card-header"&gt;
                &lt;span class="health-card-title"&gt;SQLite Metadata Store&lt;/span&gt;
                &lt;span id="healthSqliteBadge" class="badge badge-secondary"&gt;Checking...&lt;/span&gt;
              &lt;/div&gt;
              &lt;div id="healthSqliteDesc" class="health-card-desc"&gt;metadata.db in Write-Ahead-Log (WAL) mode&lt;/div&gt;
            &lt;/div&gt;

            &lt;div id="healthCardIndexer" class="health-card"&gt;
              &lt;div class="health-card-header"&gt;
                &lt;span class="health-card-title"&gt;Document Watcher Service&lt;/span&gt;
                &lt;span id="healthIndexerBadge" class="badge badge-secondary"&gt;Checking...&lt;/span&gt;
              &lt;/div&gt;
              &lt;div id="healthIndexerDesc" class="health-card-desc"&gt;500ms debounced filesystem watcher over 16 folders&lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;!-- Manual Reindex Operations Card --&gt;
          &lt;div class="reindex-card"&gt;
            &lt;div class="reindex-info"&gt;
              &lt;h3 class="reindex-title"&gt;Manual Knowledge Vault Reconciliation&lt;/h3&gt;
              &lt;p class="reindex-desc"&gt;
                Scans all 16 vault folders, verifies file SHA-256 hashes against SQLite, purges deleted document vectors from Qdrant, and indexes modified notes and PDF manuals in batches.
              &lt;/p&gt;
            &lt;/div&gt;
            &lt;div class="reindex-action"&gt;
              &lt;button id="reindexBtn" class="btn btn-warning"&gt;
                &lt;svg id="reindexIcon" viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/&gt;&lt;/svg&gt;
                &lt;span id="reindexBtnText"&gt;Trigger Vault Reindex&lt;/span&gt;
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/section&gt;
      &lt;/main&gt;
    &lt;/div&gt;

    &lt;!-- Document Viewer Modal Dialog --&gt;
    &lt;div id="docViewerModal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="modalDocTitle"&gt;
      &lt;div class="modal-window"&gt;
        &lt;div class="modal-header"&gt;
          &lt;div class="modal-header-meta"&gt;
            &lt;h3 id="modalDocTitle" class="modal-title"&gt;Document Title&lt;/h3&gt;
            &lt;span id="modalDocPath" class="modal-path"&gt;Relative/Path/File.md&lt;/span&gt;
            &lt;span id="modalDocBadge" class="badge badge-secondary"&gt;Section / Page&lt;/span&gt;
          &lt;/div&gt;
