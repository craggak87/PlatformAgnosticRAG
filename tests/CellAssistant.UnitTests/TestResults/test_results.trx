[xUnit.net 00:00:01.08]               &lt;div class="prompt-chips"&gt;
[xUnit.net 00:00:01.08]                 &lt;button class="chip" data-query="What causes gripper timeout?"&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-query"&gt;"What causes gripper timeout?"&lt;/span&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-tag"&gt;FLT-002 / ROBOT01&lt;/span&gt;
[xUnit.net 00:00:01.08]                 &lt;/button&gt;
[xUnit.net 00:00:01.08]                 &lt;button class="chip" data-query="What causes alarm ALM-205?"&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-query"&gt;"What causes alarm ALM-205?"&lt;/span&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-tag"&gt;ALM-205 / CONV01&lt;/span&gt;
[xUnit.net 00:00:01.08]                 &lt;/button&gt;
[xUnit.net 00:00:01.08]                 &lt;button class="chip" data-query="What inputs are used for Safety Gate 2 interlocks?"&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-query"&gt;"What inputs are used for Safety Gate 2 interlocks?"&lt;/span&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-tag"&gt;PLC01 / Safety&lt;/span&gt;
[xUnit.net 00:00:01.08]                 &lt;/button&gt;
[xUnit.net 00:00:01.08]                 &lt;button class="chip" data-query="How to reset conveyor drive overload on VFD01?"&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-query"&gt;"How to reset conveyor drive overload on VFD01?"&lt;/span&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="chip-tag"&gt;VFD01 / Faults&lt;/span&gt;
[xUnit.net 00:00:01.08]                 &lt;/button&gt;
[xUnit.net 00:00:01.08]               &lt;/div&gt;
[xUnit.net 00:00:01.08]             &lt;/div&gt;
[xUnit.net 00:00:01.08]           `;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Re-bind prompt chips
[xUnit.net 00:00:01.08]           document.querySelectorAll('.chip').forEach(chip =&gt; {
[xUnit.net 00:00:01.08]             chip.addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]               const q = chip.getAttribute('data-query');
[xUnit.net 00:00:01.08]               if (q) {
[xUnit.net 00:00:01.08]                 document.getElementById('queryInput').value = q;
[xUnit.net 00:00:01.08]                 this.submitQuery();
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]             });
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           document.getElementById('queryInput').value = '';
[xUnit.net 00:00:01.08]           document.getElementById('queryInput').style.height = 'auto';
[xUnit.net 00:00:01.08]           document.getElementById('charCounter').textContent = '0 / 2000';
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         // Submits query and coordinates SSE stream
[xUnit.net 00:00:01.08]         async submitQuery() {
[xUnit.net 00:00:01.08]           const input = document.getElementById('queryInput');
[xUnit.net 00:00:01.08]           const question = input.value.trim();
[xUnit.net 00:00:01.08]           if (!question || this.state.isStreaming) return;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Remove empty state if present
[xUnit.net 00:00:01.08]           const emptyState = document.getElementById('emptyState');
[xUnit.net 00:00:01.08]           if (emptyState) emptyState.remove();
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           const eqFilter = this.state.equipmentFilter;
[xUnit.net 00:00:01.08]           const folderFilter = this.state.folderFilter;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // 1. Render User Message Bubble
[xUnit.net 00:00:01.08]           this.renderUserMessage(question, eqFilter, folderFilter);
[xUnit.net 00:00:01.08]           input.value = '';
[xUnit.net 00:00:01.08]           input.style.height = 'auto';
[xUnit.net 00:00:01.08]           document.getElementById('charCounter').textContent = '0 / 2000';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // 2. Prepare Assistant Message Bubble
[xUnit.net 00:00:01.08]           const { bubbleEl, bodyEl, badgeEl, citationsEl, copyBtn } = this.createAssistantMessageBubble();
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // 3. UI State: Streaming Active
[xUnit.net 00:00:01.08]           this.state.isStreaming = true;
[xUnit.net 00:00:01.08]           document.getElementById('sendBtn').disabled = true;
[xUnit.net 00:00:01.08]           document.getElementById('stopStreamBtn').classList.remove('hidden');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           this.state.abortController = new AbortController();
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           let fullAnswer = '';
[xUnit.net 00:00:01.08]           let sources = [];
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           const requestDto = {
[xUnit.net 00:00:01.08]             question: question,
[xUnit.net 00:00:01.08]             equipmentIdFilter: eqFilter || null,
[xUnit.net 00:00:01.08]             folderFilter: folderFilter || null
[xUnit.net 00:00:01.08]           };
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           await ApiClient.streamQuery(
[xUnit.net 00:00:01.08]             requestDto,
[xUnit.net 00:00:01.08]             // onMetadata
[xUnit.net 00:00:01.08]             (meta) =&gt; {
[xUnit.net 00:00:01.08]               this.updateConfidenceBadge(badgeEl, meta.confidence);
[xUnit.net 00:00:01.08]               sources = meta.sources || [];
[xUnit.net 00:00:01.08]             },
[xUnit.net 00:00:01.08]             // onToken
[xUnit.net 00:00:01.08]             (token) =&gt; {
[xUnit.net 00:00:01.08]               fullAnswer += token;
[xUnit.net 00:00:01.08]               bodyEl.innerHTML = Markdown.render(fullAnswer) + '&lt;span class="streaming-cursor"&gt;&lt;/span&gt;';
[xUnit.net 00:00:01.08]               this.scrollToBottom();
[xUnit.net 00:00:01.08]             },
[xUnit.net 00:00:01.08]             // onDone
[xUnit.net 00:00:01.08]             () =&gt; {
[xUnit.net 00:00:01.08]               this.state.isStreaming = false;
[xUnit.net 00:00:01.08]               document.getElementById('sendBtn').disabled = false;
[xUnit.net 00:00:01.08]               document.getElementById('stopStreamBtn').classList.add('hidden');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               // Remove cursor and finish rendering
[xUnit.net 00:00:01.08]               bodyEl.innerHTML = Markdown.render(fullAnswer);
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               // Render Citations
[xUnit.net 00:00:01.08]               if (sources &amp;&amp; sources.length &gt; 0) {
[xUnit.net 00:00:01.08]                 this.renderCitations(citationsEl, sources);
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               // Enable copy button
[xUnit.net 00:00:01.08]               copyBtn.addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]                 navigator.clipboard.writeText(fullAnswer).then(() =&gt; {
[xUnit.net 00:00:01.08]                   copyBtn.classList.add('copied');
[xUnit.net 00:00:01.08]                   copyBtn.innerHTML = `
[xUnit.net 00:00:01.08]                     &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/&gt;&lt;/svg&gt;
[xUnit.net 00:00:01.08]                     &lt;span&gt;Copied!&lt;/span&gt;
[xUnit.net 00:00:01.08]                   `;
[xUnit.net 00:00:01.08]                   setTimeout(() =&gt; {
[xUnit.net 00:00:01.08]                     copyBtn.classList.remove('copied');
[xUnit.net 00:00:01.08]                     copyBtn.innerHTML = `
[xUnit.net 00:00:01.08]                       &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/&gt;&lt;/svg&gt;
[xUnit.net 00:00:01.08]                       &lt;span&gt;Copy Answer&lt;/span&gt;
[xUnit.net 00:00:01.08]                     `;
[xUnit.net 00:00:01.08]                   }, 2000);
[xUnit.net 00:00:01.08]                 });
[xUnit.net 00:00:01.08]               });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               this.scrollToBottom();
[xUnit.net 00:00:01.08]               this.loadSearchHistory();
[xUnit.net 00:00:01.08]             },
[xUnit.net 00:00:01.08]             // onError
[xUnit.net 00:00:01.08]             (errorMsg) =&gt; {
[xUnit.net 00:00:01.08]               this.state.isStreaming = false;
[xUnit.net 00:00:01.08]               document.getElementById('sendBtn').disabled = false;
[xUnit.net 00:00:01.08]               document.getElementById('stopStreamBtn').classList.add('hidden');
[xUnit.net 00:00:01.08]               bodyEl.innerHTML = `&lt;div style="color: var(--status-red);"&gt;&lt;strong&gt;Error:&lt;/strong&gt; ${errorMsg}&lt;/div&gt;`;
[xUnit.net 00:00:01.08]               Toast.show(errorMsg, 'error');
[xUnit.net 00:00:01.08]             },
[xUnit.net 00:00:01.08]             this.state.abortController.signal
[xUnit.net 00:00:01.08]           );
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         renderUserMessage(question, eqFilter, folderFilter) {
[xUnit.net 00:00:01.08]           const container = document.getElementById('messagesContainer');
[xUnit.net 00:00:01.08]           const row = document.createElement('div');
[xUnit.net 00:00:01.08]           row.className = 'message-row';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           let filtersHtml = '';
[xUnit.net 00:00:01.08]           if (eqFilter || folderFilter) {
[xUnit.net 00:00:01.08]             filtersHtml = '&lt;div class="user-filters"&gt;';
[xUnit.net 00:00:01.08]             if (eqFilter) filtersHtml += `&lt;span class="filter-badge"&gt;Eq: ${eqFilter}&lt;/span&gt;`;
[xUnit.net 00:00:01.08]             if (folderFilter) filtersHtml += `&lt;span class="filter-badge"&gt;Folder: ${folderFilter}&lt;/span&gt;`;
[xUnit.net 00:00:01.08]             filtersHtml += '&lt;/div&gt;';
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           row.innerHTML = `
[xUnit.net 00:00:01.08]             &lt;div class="message-bubble user-message"&gt;
[xUnit.net 00:00:01.08]               &lt;div class="user-text"&gt;${this.escapeHtml(question)}&lt;/div&gt;
[xUnit.net 00:00:01.08]               ${filtersHtml}
[xUnit.net 00:00:01.08]             &lt;/div&gt;
[xUnit.net 00:00:01.08]           `;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           container.appendChild(row);
[xUnit.net 00:00:01.08]           this.scrollToBottom();
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         createAssistantMessageBubble() {
[xUnit.net 00:00:01.08]           const container = document.getElementById('messagesContainer');
[xUnit.net 00:00:01.08]           const row = document.createElement('div');
[xUnit.net 00:00:01.08]           row.className = 'message-row';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           row.innerHTML = `
[xUnit.net 00:00:01.08]             &lt;div class="message-bubble assistant-message"&gt;
[xUnit.net 00:00:01.08]               &lt;div class="message-header"&gt;
[xUnit.net 00:00:01.08]                 &lt;div class="message-sender"&gt;
[xUnit.net 00:00:01.08]                   &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/&gt;&lt;/svg&gt;
[xUnit.net 00:00:01.08]                   &lt;span&gt;Cell Knowledge Assistant&lt;/span&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="confidence-badge-slot"&gt;&lt;/span&gt;
[xUnit.net 00:00:01.08]                 &lt;/div&gt;
[xUnit.net 00:00:01.08]                 &lt;div class="message-actions"&gt;
[xUnit.net 00:00:01.08]                   &lt;button class="btn-copy" title="Copy answer to clipboard"&gt;
[xUnit.net 00:00:01.08]                     &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/&gt;&lt;/svg&gt;
[xUnit.net 00:00:01.08]                     &lt;span&gt;Copy Answer&lt;/span&gt;
[xUnit.net 00:00:01.08]                   &lt;/button&gt;
[xUnit.net 00:00:01.08]                 &lt;/div&gt;
[xUnit.net 00:00:01.08]               &lt;/div&gt;
[xUnit.net 00:00:01.08]               &lt;div class="message-body"&gt;
[xUnit.net 00:00:01.08]                 &lt;span class="streaming-cursor"&gt;&lt;/span&gt;
[xUnit.net 00:00:01.08]               &lt;/div&gt;
[xUnit.net 00:00:01.08]               &lt;div class="citations-slot"&gt;&lt;/div&gt;
[xUnit.net 00:00:01.08]             &lt;/div&gt;
[xUnit.net 00:00:01.08]           `;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           container.appendChild(row);
[xUnit.net 00:00:01.08]           this.scrollToBottom();
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           return {
[xUnit.net 00:00:01.08]             bubbleEl: row.querySelector('.assistant-message'),
[xUnit.net 00:00:01.08]             bodyEl: row.querySelector('.message-body'),
[xUnit.net 00:00:01.08]             badgeEl: row.querySelector('.confidence-badge-slot'),
[xUnit.net 00:00:01.08]             citationsEl: row.querySelector('.citations-slot'),
[xUnit.net 00:00:01.08]             copyBtn: row.querySelector('.btn-copy')
[xUnit.net 00:00:01.08]           };
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         // Sets confidence badge following Feature 23 E2E test standard
[xUnit.net 00:00:01.08]         updateConfidenceBadge(badgeEl, confidence) {
[xUnit.net 00:00:01.08]           if (!badgeEl) return;
[xUnit.net 00:00:01.08]           const level = (confidence || 'Low').trim();
[xUnit.net 00:00:01.08]           let badgeClass = 'badge-secondary';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           if (level.equalsIgnoreCase('High')) {
[xUnit.net 00:00:01.08]             badgeClass = 'badge-success'; // Green
[xUnit.net 00:00:01.08]           } else if (level.equalsIgnoreCase('Medium')) {
[xUnit.net 00:00:01.08]             badgeClass = 'badge-warning'; // Yellow / Amber
[xUnit.net 00:00:01.08]           } else if (level.equalsIgnoreCase('Low')) {
[xUnit.net 00:00:01.08]             badgeClass = 'badge-danger';  // Red
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           badgeEl.innerHTML = `&lt;span class="badge ${badgeClass}"&gt;&lt;span class="badge-dot"&gt;&lt;/span&gt;${level} Confidence&lt;/span&gt;`;
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         // Renders Citation Cards with Click-to-Open
[xUnit.net 00:00:01.08]         renderCitations(citationsEl, sources) {
[xUnit.net 00:00:01.08]           if (!citationsEl || !sources || sources.length === 0) return;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           let html = `
[xUnit.net 00:00:01.08]             &lt;div class="citations-wrapper"&gt;
[xUnit.net 00:00:01.08]               &lt;div class="citations-header"&gt;
[xUnit.net 00:00:01.08]                 &lt;svg viewBox="0 0 24 24" class="svg-icon-xs"&gt;&lt;path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/&gt;&lt;/svg&gt;
[xUnit.net 00:00:01.08]                 &lt;span&gt;Sources Referenced (${sources.length})&lt;/span&gt;
[xUnit.net 00:00:01.08]               &lt;/div&gt;
[xUnit.net 00:00:01.08]               &lt;div class="citation-cards-grid"&gt;
[xUnit.net 00:00:01.08]           `;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           sources.forEach((src) =&gt; {
[xUnit.net 00:00:01.08]             const isPdf = src.fileName.toLowerCase().endsWith('.pdf');
[xUnit.net 00:00:01.08]             const badgeType = isPdf ? '&lt;span class="file-badge-type type-pdf"&gt;PDF&lt;/span&gt;' : '&lt;span class="file-badge-type type-md"&gt;MD&lt;/span&gt;';
[xUnit.net 00:00:01.08]             
[xUnit.net 00:00:01.08]             let locText = '';
[xUnit.net 00:00:01.08]             if (src.pageNumber) {
[xUnit.net 00:00:01.08]               locText = `&lt;span&gt;Page ${src.pageNumber}&lt;/span&gt;`;
[xUnit.net 00:00:01.08]             } else if (src.sectionHeading) {
[xUnit.net 00:00:01.08]               locText = `&lt;span&gt;§ ${this.escapeHtml(src.sectionHeading)}&lt;/span&gt;`;
[xUnit.net 00:00:01.08]             } else {
[xUnit.net 00:00:01.08]               locText = `&lt;span&gt;${this.escapeHtml(src.relativePath)}&lt;/span&gt;`;
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             html += `
[xUnit.net 00:00:01.08]               &lt;div class="citation-card" data-doc-id="${src.documentId}" data-filename="${this.escapeHtml(src.fileName)}" data-path="${this.escapeHtml(src.relativePath)}" data-page="${src.pageNumber || ''}" data-section="${this.escapeHtml(src.sectionHeading || '')}"&gt;
[xUnit.net 00:00:01.08]                 &lt;div class="citation-card-top"&gt;
[xUnit.net 00:00:01.08]                   ${badgeType}
[xUnit.net 00:00:01.08]                   &lt;span class="citation-file-name" title="${this.escapeHtml(src.fileName)}"&gt;${this.escapeHtml(src.fileName)}&lt;/span&gt;
[xUnit.net 00:00:01.08]                 &lt;/div&gt;
[xUnit.net 00:00:01.08]                 &lt;div class="citation-details"&gt;
[xUnit.net 00:00:01.08]                   ${locText}
[xUnit.net 00:00:01.08]                 &lt;/div&gt;
[xUnit.net 00:00:01.08]                 &lt;div class="citation-path"&gt;${this.escapeHtml(src.relativePath)}&lt;/div&gt;
[xUnit.net 00:00:01.08]               &lt;/div&gt;
[xUnit.net 00:00:01.08]             `;
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           html += `&lt;/div&gt;&lt;/div&gt;`;
[xUnit.net 00:00:01.08]           citationsEl.innerHTML = html;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Attach click handlers to open viewer modal
[xUnit.net 00:00:01.08]           citationsEl.querySelectorAll('.citation-card').forEach(card =&gt; {
[xUnit.net 00:00:01.08]             card.addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]               const docId = card.getAttribute('data-doc-id');
[xUnit.net 00:00:01.08]               const fileName = card.getAttribute('data-filename');
[xUnit.net 00:00:01.08]               const relPath = card.getAttribute('data-path');
[xUnit.net 00:00:01.08]               const pageNumber = card.getAttribute('data-page');
[xUnit.net 00:00:01.08]               const sectionHeading = card.getAttribute('data-section');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               this.openDocumentModal({
[xUnit.net 00:00:01.08]                 documentId: docId,
[xUnit.net 00:00:01.08]                 fileName,
[xUnit.net 00:00:01.08]                 relativePath: relPath,
[xUnit.net 00:00:01.08]                 pageNumber: pageNumber ? parseInt(pageNumber, 10) : null,
[xUnit.net 00:00:01.08]                 sectionHeading
[xUnit.net 00:00:01.08]               });
[xUnit.net 00:00:01.08]             });
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         // Opens Document Viewer Modal (PDF or Markdown)
[xUnit.net 00:00:01.08]         async openDocumentModal(source) {
[xUnit.net 00:00:01.08]           const modal = document.getElementById('docViewerModal');
[xUnit.net 00:00:01.08]           const titleEl = document.getElementById('modalDocTitle');
[xUnit.net 00:00:01.08]           const pathEl = document.getElementById('modalDocPath');
[xUnit.net 00:00:01.08]           const badgeEl = document.getElementById('modalDocBadge');
[xUnit.net 00:00:01.08]           const extLink = document.getElementById('modalExternalLink');
[xUnit.net 00:00:01.08]           const loadingEl = document.getElementById('modalLoading');
[xUnit.net 00:00:01.08]           const errorEl = document.getElementById('modalError');
[xUnit.net 00:00:01.08]           const mdContent = document.getElementById('modalMarkdownContent');
[xUnit.net 00:00:01.08]           const pdfContainer = document.getElementById('modalPdfContainer');
[xUnit.net 00:00:01.08]           const pdfFrame = document.getElementById('modalPdfFrame');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           modal.classList.remove('hidden');
[xUnit.net 00:00:01.08]           titleEl.textContent = source.fileName;
[xUnit.net 00:00:01.08]           pathEl.textContent = source.relativePath;
[xUnit.net 00:00:01.08]           
[xUnit.net 00:00:01.08]           if (source.pageNumber) {
[xUnit.net 00:00:01.08]             badgeEl.textContent = `Page ${source.pageNumber}`;
[xUnit.net 00:00:01.08]           } else if (source.sectionHeading) {
[xUnit.net 00:00:01.08]             badgeEl.textContent = `§ ${source.sectionHeading}`;
[xUnit.net 00:00:01.08]           } else {
[xUnit.net 00:00:01.08]             badgeEl.textContent = 'Document';
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           loadingEl.classList.remove('hidden');
[xUnit.net 00:00:01.08]           errorEl.classList.add('hidden');
[xUnit.net 00:00:01.08]           mdContent.innerHTML = '';
[xUnit.net 00:00:01.08]           pdfContainer.classList.add('hidden');
[xUnit.net 00:00:01.08]           pdfFrame.src = 'about:blank';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           const isPdf = source.fileName.toLowerCase().endsWith('.pdf');
[xUnit.net 00:00:01.08]           const fileUrl = `/api/documents/${source.documentId}/file` + (source.pageNumber ? `#page=${source.pageNumber}` : '');
[xUnit.net 00:00:01.08]           extLink.href = fileUrl;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           try {
[xUnit.net 00:00:01.08]             if (isPdf) {
[xUnit.net 00:00:01.08]               loadingEl.classList.add('hidden');
[xUnit.net 00:00:01.08]               pdfContainer.classList.remove('hidden');
[xUnit.net 00:00:01.08]               pdfFrame.src = fileUrl;
[xUnit.net 00:00:01.08]             } else {
[xUnit.net 00:00:01.08]               const docData = await ApiClient.getDocumentFile(source.documentId);
[xUnit.net 00:00:01.08]               loadingEl.classList.add('hidden');
[xUnit.net 00:00:01.08]               mdContent.innerHTML = Markdown.render(docData.text);
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               // If a section heading is specified, scroll to it and highlight
[xUnit.net 00:00:01.08]               if (source.sectionHeading) {
[xUnit.net 00:00:01.08]                 setTimeout(() =&gt; {
[xUnit.net 00:00:01.08]                   const headingCandidates = mdContent.querySelectorAll('h1, h2, h3');
[xUnit.net 00:00:01.08]                   for (const h of headingCandidates) {
[xUnit.net 00:00:01.08]                     if (h.textContent.toLowerCase().includes(source.sectionHeading.toLowerCase())) {
[xUnit.net 00:00:01.08]                       h.classList.add('highlight-heading');
[xUnit.net 00:00:01.08]                       h.scrollIntoView({ behavior: 'smooth', block: 'start' });
[xUnit.net 00:00:01.08]                       break;
[xUnit.net 00:00:01.08]                     }
[xUnit.net 00:00:01.08]                   }
[xUnit.net 00:00:01.08]                 }, 100);
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]           } catch (err) {
[xUnit.net 00:00:01.08]             loadingEl.classList.add('hidden');
[xUnit.net 00:00:01.08]             errorEl.classList.remove('hidden');
[xUnit.net 00:00:01.08]             errorEl.textContent = `Failed to load document: ${err.message}`;
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         closeModal() {
[xUnit.net 00:00:01.08]           const modal = document.getElementById('docViewerModal');
[xUnit.net 00:00:01.08]           modal.classList.add('hidden');
[xUnit.net 00:00:01.08]           document.getElementById('modalPdfFrame').src = 'about:blank';
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         // Loads search history from GET /api/history
[xUnit.net 00:00:01.08]         async loadSearchHistory() {
[xUnit.net 00:00:01.08]           const listEl = document.getElementById('historyList');
[xUnit.net 00:00:01.08]           try {
[xUnit.net 00:00:01.08]             const history = await ApiClient.getHistory(20);
[xUnit.net 00:00:01.08]             if (!history || history.length === 0) {
[xUnit.net 00:00:01.08]               listEl.innerHTML = '&lt;div class="history-empty"&gt;No search queries yet.&lt;/div&gt;';
[xUnit.net 00:00:01.08]               return;
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             listEl.innerHTML = '';
[xUnit.net 00:00:01.08]             history.forEach(item =&gt; {
[xUnit.net 00:00:01.08]               const itemEl = document.createElement('div');
[xUnit.net 00:00:01.08]               itemEl.className = 'history-item';
[xUnit.net 00:00:01.08]               
[xUnit.net 00:00:01.08]               let confClass = 'badge-secondary';
[xUnit.net 00:00:01.08]               const conf = (item.confidence || 'Low').toLowerCase();
[xUnit.net 00:00:01.08]               if (conf === 'high') confClass = 'badge-success';
[xUnit.net 00:00:01.08]               else if (conf === 'medium') confClass = 'badge-warning';
[xUnit.net 00:00:01.08]               else if (conf === 'low') confClass = 'badge-danger';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               const askedTime = item.askedUtc ? new Date(item.askedUtc).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               itemEl.innerHTML = `
[xUnit.net 00:00:01.08]                 &lt;div class="history-question" title="${this.escapeHtml(item.question)}"&gt;${this.escapeHtml(item.question)}&lt;/div&gt;
[xUnit.net 00:00:01.08]                 &lt;div class="history-meta"&gt;
[xUnit.net 00:00:01.08]                   &lt;span class="badge ${confClass}"&gt;${item.confidence}&lt;/span&gt;
[xUnit.net 00:00:01.08]                   &lt;span&gt;${askedTime}&lt;/span&gt;
[xUnit.net 00:00:01.08]                 &lt;/div&gt;
[xUnit.net 00:00:01.08]               `;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               itemEl.addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]                 this.switchTab('chat');
[xUnit.net 00:00:01.08]                 document.getElementById('queryInput').value = item.question;
[xUnit.net 00:00:01.08]                 // Replay conversation in chat viewport
[xUnit.net 00:00:01.08]                 const emptyState = document.getElementById('emptyState');
[xUnit.net 00:00:01.08]                 if (emptyState) emptyState.remove();
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]                 this.renderUserMessage(item.question, null, null);
[xUnit.net 00:00:01.08]                 const { bodyEl, badgeEl, citationsEl, copyBtn } = this.createAssistantMessageBubble();
[xUnit.net 00:00:01.08]                 this.updateConfidenceBadge(badgeEl, item.confidence);
[xUnit.net 00:00:01.08]                 bodyEl.innerHTML = Markdown.render(item.answer || '');
[xUnit.net 00:00:01.08]                 if (item.sources &amp;&amp; item.sources.length &gt; 0) {
[xUnit.net 00:00:01.08]                   this.renderCitations(citationsEl, item.sources);
[xUnit.net 00:00:01.08]                 }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]                 copyBtn.addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]                   navigator.clipboard.writeText(item.answer || '').then(() =&gt; {
[xUnit.net 00:00:01.08]                     Toast.show('Answer copied to clipboard!', 'info');
[xUnit.net 00:00:01.08]                   });
[xUnit.net 00:00:01.08]                 });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]                 this.scrollToBottom();
[xUnit.net 00:00:01.08]               });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               listEl.appendChild(itemEl);
[xUnit.net 00:00:01.08]             });
[xUnit.net 00:00:01.08]           } catch (err) {
[xUnit.net 00:00:01.08]             listEl.innerHTML = '&lt;div class="history-empty"&gt;Could not load history.&lt;/div&gt;';
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         // Checks /api/health and updates status indicator
[xUnit.net 00:00:01.08]         async checkHealth() {
[xUnit.net 00:00:01.08]           const badge = document.getElementById('systemHealthBadge');
[xUnit.net 00:00:01.08]           const text = document.getElementById('systemHealthText');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           try {
[xUnit.net 00:00:01.08]             const res = await ApiClient.getHealth();
[xUnit.net 00:00:01.08]             const isHealthy = res.status === 200 &amp;&amp; (res.data.status === 'Healthy' || res.data.api === 'Healthy');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             badge.classList.remove('healthy', 'unhealthy');
[xUnit.net 00:00:01.08]             if (isHealthy) {
[xUnit.net 00:00:01.08]               badge.classList.add('healthy');
[xUnit.net 00:00:01.08]               text.textContent = 'System Online';
[xUnit.net 00:00:01.08]             } else {
[xUnit.net 00:00:01.08]               badge.classList.add('unhealthy');
[xUnit.net 00:00:01.08]               text.textContent = res.data.status || 'Degraded';
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             // If viewing admin dashboard, update subsystem cards
[xUnit.net 00:00:01.08]             if (this.state.currentTab === 'admin') {
[xUnit.net 00:00:01.08]               this.updateHealthCards(res.data);
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]           } catch (_) {
[xUnit.net 00:00:01.08]             badge.classList.remove('healthy');
[xUnit.net 00:00:01.08]             badge.classList.add('unhealthy');
[xUnit.net 00:00:01.08]             text.textContent = 'Offline';
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         // Loads admin dashboard metrics
[xUnit.net 00:00:01.08]         async loadAdminMetrics() {
[xUnit.net 00:00:01.08]           const docCountEl = document.getElementById('metricDocCount');
[xUnit.net 00:00:01.08]           const vectorCountEl = document.getElementById('metricVectorCount');
[xUnit.net 00:00:01.08]           const lastRunEl = document.getElementById('metricLastRun');
[xUnit.net 00:00:01.08]           const indexerStateEl = document.getElementById('metricIndexerState');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           try {
[xUnit.net 00:00:01.08]             const res = await ApiClient.getHealth();
[xUnit.net 00:00:01.08]             const healthData = res.data;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             this.updateHealthCards(healthData);
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             // Extract metrics if available or use descriptors
[xUnit.net 00:00:01.08]             if (healthData.components) {
[xUnit.net 00:00:01.08]               const comps = healthData.components;
[xUnit.net 00:00:01.08]               if (comps.indexer) {
[xUnit.net 00:00:01.08]                 indexerStateEl.textContent = comps.indexer.status || 'Idle';
[xUnit.net 00:00:01.08]                 lastRunEl.textContent = comps.indexer.description ? comps.indexer.description.replace('Watcher active, ', '') : 'Recent';
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]               if (comps.sqlite &amp;&amp; comps.sqlite.description) {
[xUnit.net 00:00:01.08]                 const m = comps.sqlite.description.match(/(\d+)\s+docs/);
[xUnit.net 00:00:01.08]                 if (m) docCountEl.textContent = m[1];
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]               if (comps.qdrant &amp;&amp; comps.qdrant.description) {
[xUnit.net 00:00:01.08]                 const m = comps.qdrant.description.match(/(\d+)\s+vectors/);
[xUnit.net 00:00:01.08]                 if (m) vectorCountEl.textContent = m[1];
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             // If flattened format
[xUnit.net 00:00:01.08]             if (indexerStateEl.textContent === '--') {
[xUnit.net 00:00:01.08]               indexerStateEl.textContent = healthData.indexer || 'Idle';
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]           } catch (err) {
[xUnit.net 00:00:01.08]             Toast.show('Failed to load system metrics: ' + err.message, 'error');
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         updateHealthCards(healthData) {
[xUnit.net 00:00:01.08]           const updateCard = (badgeId, descId, status, desc) =&gt; {
[xUnit.net 00:00:01.08]             const badge = document.getElementById(badgeId);
[xUnit.net 00:00:01.08]             const descEl = document.getElementById(descId);
[xUnit.net 00:00:01.08]             if (!badge) return;
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             const isHealthy = (status || '').toLowerCase() === 'healthy';
[xUnit.net 00:00:01.08]             badge.className = `badge ${isHealthy ? 'badge-success' : 'badge-danger'}`;
[xUnit.net 00:00:01.08]             badge.textContent = status || 'Unknown';
[xUnit.net 00:00:01.08]             if (desc &amp;&amp; descEl) descEl.textContent = desc;
[xUnit.net 00:00:01.08]           };
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           if (healthData.components) {
[xUnit.net 00:00:01.08]             const c = healthData.components;
[xUnit.net 00:00:01.08]             if (c.api) updateCard('healthApiBadge', 'healthApiDesc', c.api.status, c.api.description);
[xUnit.net 00:00:01.08]             if (c.ollama) updateCard('healthOllamaBadge', 'healthOllamaDesc', c.ollama.status, c.ollama.description);
[xUnit.net 00:00:01.08]             if (c.qdrant) updateCard('healthQdrantBadge', 'healthQdrantDesc', c.qdrant.status, c.qdrant.description);
[xUnit.net 00:00:01.08]             if (c.sqlite) updateCard('healthSqliteBadge', 'healthSqliteDesc', c.sqlite.status, c.sqlite.description);
[xUnit.net 00:00:01.08]             if (c.indexer) updateCard('healthIndexerBadge', 'healthIndexerDesc', c.indexer.status, c.indexer.description);
[xUnit.net 00:00:01.08]           } else {
[xUnit.net 00:00:01.08]             // Flattened HealthResponseDto
[xUnit.net 00:00:01.08]             updateCard('healthApiBadge', 'healthApiDesc', healthData.api);
[xUnit.net 00:00:01.08]             updateCard('healthOllamaBadge', 'healthOllamaDesc', healthData.ollama);
[xUnit.net 00:00:01.08]             updateCard('healthQdrantBadge', 'healthQdrantDesc', healthData.qdrant);
[xUnit.net 00:00:01.08]             updateCard('healthSqliteBadge', 'healthSqliteDesc', healthData.sqlite);
[xUnit.net 00:00:01.08]             updateCard('healthIndexerBadge', 'healthIndexerDesc', healthData.indexer);
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]         },
