          <Message>Expected css "/* ==========================================================================
   Cell Knowledge Assistant — Industrial Design System
   Zero external dependencies. High contrast dark theme for industrial HMIs.
   ========================================================================== */

:root {
  /* Surface Color Palette */
  --bg-app: #0b0f17;
  --bg-header: #111724;
  --bg-sidebar: #0e131d;
  --bg-card: #151d2d;
  --bg-card-hover: #1c263a;
  --bg-input: #0e1420;
  --bg-bubble-user: #1b263b;
  --bg-bubble-bot: #151d2d;

  /* Accent &amp; Industrial Status Colors */
  --cyan-primary: #00b4d8;
  --cyan-hover: #48cae4;
  --cyan-dim: rgba(0, 180, 216, 0.15);
  --blue-brand: #0077b6;
  
  --status-green: #10b981;
  --badge-green-bg: rgba(16, 185, 129, 0.15);
  --badge-green-border: #059669;
  
  --status-yellow: #f59e0b;
  --badge-yellow-bg: rgba(245, 158, 11, 0.15);
  --badge-yellow-border: #d97706;
  
  --status-red: #ef4444;
  --badge-red-bg: rgba(239, 68, 68, 0.15);
  --badge-red-border: #dc2626;

  --badge-gray-bg: rgba(148, 163, 184, 0.15);
  --badge-gray-border: #64748b;

  /* Typography Colors */
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-cyan: #38bdf8;
  --text-code: #e2e8f0;

  /* Borders &amp; Dividers */
  --border-subtle: #1e293b;
  --border-medium: #2a374d;
  --border-bright: #38bdf8;

  /* Typography Stack */
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;

  /* Sizing, Radii, Shadows */
  --radius-xs: 3px;
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.6);
  --shadow-glow: 0 0 12px rgba(0, 180, 216, 0.25);
}

/* Base Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-app);
  color: var(--text-primary);
  line-height: 1.5;
  height: 100vh;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

/* App Shell Layout */
.app-layout {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* Header */
.app-header {
  height: 56px;
  background-color: var(--bg-header);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  flex-shrink: 0;
  z-index: 20;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-icon {
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, var(--blue-brand), var(--cyan-primary));
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.svg-icon-brand {
  width: 20px;
  height: 20px;
  fill: #ffffff;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.3px;
  color: var(--text-primary);
}

.brand-subtitle {
  font-size: 0.7rem;
  color: var(--cyan-primary);
  letter-spacing: 0.2px;
}

.header-nav {
  display: flex;
  align-items: center;
  gap: 6px;
}

.nav-tab {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.15s ease-in-out;
}

.nav-tab:hover {
  color: var(--text-primary);
  background-color: var(--bg-card);
}

.nav-tab.active {
  color: var(--text-cyan);
  background-color: var(--cyan-dim);
  border-color: rgba(0, 180, 216, 0.4);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.health-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  background-color: var(--bg-card);
  border: 1px solid var(--border-medium);
}

.status-indicator-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--status-yellow);
  box-shadow: 0 0 6px var(--status-yellow);
}

.health-pill.healthy .status-indicator-dot {
  background-color: var(--status-green);
  box-shadow: 0 0 6px var(--status-green);
}

.health-pill.unhealthy .status-indicator-dot {
  background-color: var(--status-red);
  box-shadow: 0 0 6px var(--status-red);
}

.mode-badge {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #38bdf8;
  background-color: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.3);
  padding: 3px 8px;
  border-radius: var(--radius-xs);
}

/* App Body Grid */
.app-body {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* History Sidebar */
.sidebar {
  width: 300px;
  background-color: var(--bg-sidebar);
  border-right: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  transition: width 0.2s ease, transform 0.2s ease;
  flex-shrink: 0;
  z-index: 10;
}

.sidebar.collapsed {
  width: 0;
  overflow: hidden;
  border-right: none;
}

.sidebar-header {
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
}

.sidebar-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.history-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.history-item {
  padding: 8px 10px;
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  cursor: pointer;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 4px;
  transition: background-color 0.12s ease;
}

.history-item:hover {
  background-color: var(--bg-card);
  border-color: var(--border-subtle);
}

.history-question {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.7rem;
  color: var(--text-muted);
}

.history-empty {
  padding: 24px 12px;
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* Main Viewport */
.main-viewport {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.view-panel {
  display: none;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.view-panel.active {
  display: flex;
}

/* Filter Controls Bar */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 8px 20px;
  background-color: var(--bg-sidebar);
  border-bottom: 1px solid var(--border-subtle);
  flex-shrink: 0;
}

.filter-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.filter-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 4px;
}

.filter-select {
  background-color: var(--bg-input);
  color: var(--text-primary);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-xs);
  padding: 4px 8px;
  font-size: 0.75rem;
  outline: none;
  cursor: pointer;
}

.filter-select:focus {
  border-color: var(--cyan-primary);
}

/* Messages Container */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Empty State */
.empty-state {
  margin: auto;
  max-width: 640px;
  text-align: center;
  padding: 32px 16px;
}

.empty-state-icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background-color: var(--cyan-dim);
  display: flex;
  align-items: center;
  justify-content: center;
}

.svg-icon-hero {
  width: 32px;
  height: 32px;
  fill: var(--cyan-primary);
}

.empty-state-title {
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text-primary);
}

.empty-state-desc {
  font-size: 0.88rem;
  color: var(--text-secondary);
  margin-bottom: 24px;
}

.prompt-chips {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 10px;
}

.chip {
  background-color: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  cursor: pointer;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 4px;
  transition: all 0.15s ease;
}

.chip:hover {
  background-color: var(--bg-card-hover);
  border-color: var(--cyan-primary);
  transform: translateY(-1px);
}

.chip-query {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-primary);
}

.chip-tag {
  font-size: 0.7rem;
  color: var(--cyan-primary);
  font-family: var(--font-mono);
}

/* Chat Message Bubbles */
.message-row {
  display: flex;
  flex-direction: column;
  max-width: 900px;
  width: 100%;
  margin: 0 auto;
}

.message-bubble {
  border-radius: var(--radius-md);
  padding: 14px 18px;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.user-message {
  align-self: flex-end;
  background-color: var(--bg-bubble-user);
  border: 1px solid rgba(0, 180, 216, 0.25);
  max-width: 80%;
}

.user-text {
  font-size: 0.92rem;
  color: var(--text-primary);
  white-space: pre-wrap;
}

.user-filters {
  display: flex;
  gap: 6px;
  margin-top: 6px;
}

.filter-badge {
  font-size: 0.68rem;
  font-family: var(--font-mono);
  background-color: rgba(0, 0, 0, 0.3);
  color: var(--cyan-primary);
  padding: 2px 6px;
  border-radius: var(--radius-xs);
}

.assistant-message {
  align-self: flex-start;
  background-color: var(--bg-bubble-bot);
  border: 1px solid var(--border-medium);
  width: 100%;
}

.message-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-subtle);
}

.message-sender {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--cyan-primary);
}

.message-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn-copy {
  background-color: transparent;
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-size: 0.72rem;
  padding: 3px 8px;
  border-radius: var(--radius-xs);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  transition: all 0.15s ease;
}

.btn-copy:hover {
  background-color: var(--bg-card);
  color: var(--text-primary);
  border-color: var(--border-medium);
}

.btn-copy.copied {
  color: var(--status-green);
  border-color: var(--status-green);
}

/* Confidence Badges */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 9999px;
  text-transform: capitalize;
}

.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.badge-success {
  background-color: var(--badge-green-bg);
  color: var(--status-green);
  border: 1px solid var(--badge-green-border);
}
.badge-success .badge-dot { background-color: var(--status-green); }

.badge-warning {
  background-color: var(--badge-yellow-bg);
  color: var(--status-yellow);
  border: 1px solid var(--badge-yellow-border);
}
.badge-warning .badge-dot { background-color: var(--status-yellow); }

.badge-danger {
  background-color: var(--badge-red-bg);
  color: var(--status-red);
  border: 1px solid var(--badge-red-border);
}
.badge-danger .badge-dot { background-color: var(--status-red); }

.badge-secondary {
  background-color: var(--badge-gray-bg);
  color: var(--text-secondary);
  border: 1px solid var(--badge-gray-border);
}
.badge-secondary .badge-dot { background-color: var(--text-secondary); }

/* Markdown Answer Body */
.message-body {
  font-size: 0.92rem;
  color: var(--text-primary);
  line-height: 1.6;
}

.message-body p {
  margin-bottom: 12px;
}

.message-body p:last-child {
  margin-bottom: 0;
}

.message-body h1, .message-body h2, .message-body h3 {
  color: var(--text-primary);
  margin-top: 16px;
  margin-bottom: 8px;
  font-weight: 600;
}

.message-body h1 { font-size: 1.15rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 4px; }
.message-body h2 { font-size: 1.05rem; }
.message-body h3 { font-size: 0.95rem; }

.message-body ul, .message-body ol {
  margin: 8px 0 12px 20px;
}

.message-body li {
  margin-bottom: 4px;
}

.message-body code {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  background-color: rgba(0, 0, 0, 0.4);
  color: #38bdf8;
  padding: 2px 5px;
  border-radius: var(--radius-xs);
  border: 1px solid rgba(56, 189, 248, 0.2);
}

.message-body pre {
  background-color: #080c13;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 12px;
  overflow-x: auto;
  margin: 12px 0;
}

.message-body pre code {
  background: transparent;
  padding: 0;
  border: none;
  color: var(--text-code);
  font-size: 0.82rem;
}

.message-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 12px 0;
  font-size: 0.85rem;
}

.message-body th, .message-body td {
  border: 1px solid var(--border-medium);
  padding: 6px 10px;
  text-align: left;
}

.message-body th {
  background-color: var(--bg-card);
  font-weight: 600;
}

/* Streaming Blinking Cursor */
.streaming-cursor {
  display: inline-block;
  width: 7px;
  height: 14px;
  background-color: var(--cyan-primary);
  margin-left: 3px;
  vertical-align: middle;
  animation: blink 0.8s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* Citations Section */
.citations-wrapper {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--border-subtle);
}

.citations-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-secondary);
  margin-bottom: 10px;
}

.citation-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 10px;
}

.citation-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.citation-card:hover {
  border-color: var(--cyan-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}

.citation-card-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.file-badge-type {
  font-size: 0.65rem;
  font-weight: 700;
  font-family: var(--font-mono);
  padding: 2px 4px;
  border-radius: var(--radius-xs);
}

.type-pdf { background-color: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }
.type-md { background-color: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); }

.citation-file-name {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.citation-details {
  font-size: 0.72rem;
  color: var(--cyan-primary);
  display: flex;
  align-items: center;
  gap: 6px;
}

.citation-path {
  font-size: 0.68rem;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Query Input Bar */
.input-section {
  padding: 16px 20px 12px;
  background-color: var(--bg-sidebar);
  border-top: 1px solid var(--border-subtle);
  flex-shrink: 0;
}

.query-form {
  max-width: 900px;
  margin: 0 auto;
}

.input-wrapper {
  background-color: var(--bg-input);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-md);
  padding: 8px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.15s ease;
}

.input-wrapper:focus-within {
  border-color: var(--cyan-primary);
  box-shadow: var(--shadow-glow);
}

.query-textarea {
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 0.92rem;
  resize: none;
  min-height: 24px;
  max-height: 180px;
  line-height: 1.4;
}

.query-textarea::placeholder {
  color: var(--text-muted);
}

.input-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}

.char-counter {
  font-size: 0.72rem;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

.btn-send {
  background: linear-gradient(135deg, var(--blue-brand), var(--cyan-primary));
  color: #ffffff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: opacity 0.15s ease;
}

.btn-send:hover:not(:disabled) {
  opacity: 0.9;
}

.btn-send:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-stop {
  background-color: rgba(239, 68, 68, 0.2);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.4);
  border-radius: var(--radius-sm);
  padding: 6px 12px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
}

.input-hint {
  font-size: 0.68rem;
  color: var(--text-muted);
  margin-top: 6px;
  text-align: right;
}

/* ==========================================================================
   Admin Dashboard Styling
   ========================================================================== */

.admin-container {
  overflow-y: auto;
  padding: 24px 28px;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
}

.admin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 16px;
}

.admin-title {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--text-primary);
}

.admin-subtitle {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-top: 4px;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}

.metric-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-md);
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.metric-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.metric-icon-blue { background-color: rgba(56, 189, 248, 0.15); color: #38bdf8; }
.metric-icon-purple { background-color: rgba(168, 85, 247, 0.15); color: #c084fc; }
.metric-icon-amber { background-color: rgba(245, 158, 11, 0.15); color: #fbbf24; }
.metric-icon-green { background-color: rgba(16, 185, 129, 0.15); color: #34d399; }

.svg-icon-metric {
  width: 24px;
  height: 24px;
  fill: currentColor;
}

.metric-body {
  display: flex;
  flex-direction: column;
}

.metric-label {
  font-size: 0.74rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-muted);
}

.metric-value {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
  margin: 2px 0;
  font-family: var(--font-mono);
}

.metric-meta {
  font-size: 0.7rem;
  color: var(--text-secondary);
}

.section-heading {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12px;
}

.health-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 12px;
  margin-bottom: 28px;
}

.health-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.health-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.health-card-title {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-primary);
}

.health-card-desc {
  font-size: 0.74rem;
  color: var(--text-secondary);
}

.reindex-card {
  background: linear-gradient(to right, var(--bg-card), #162235);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-md);
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.reindex-title {
  font-size: 0.98rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.reindex-desc {
  font-size: 0.8rem;
  color: var(--text-secondary);
  max-width: 720px;
}

.btn-warning {
  background-color: #d97706;
  color: #ffffff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 10px 18px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: background-color 0.15s ease;
}

.btn-warning:hover:not(:disabled) {
  background-color: #b45309;
}

.btn-warning:disabled {
  opacity: 0.6;
  cursor: wait;
}

/* ==========================================================================
   Document Modal Viewer
   ========================================================================== */

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(5, 8, 14, 0.85);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  padding: 20px;
}

.modal-window {
  background-color: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 980px;
  height: 85vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
}

.modal-header {
  padding: 12px 18px;
  background-color: var(--bg-header);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.modal-header-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}

.modal-title {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-path {
  font-size: 0.72rem;
  font-family: var(--font-mono);
  color: var(--text-muted);
}

.modal-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  background-color: var(--bg-app);
}

.pdf-preview, .pdf-frame {
  width: 100%;
  height: 100%;
  border: none;
}

.markdown-preview {
  max-width: 840px;
  margin: 0 auto;
  line-height: 1.7;
  color: var(--text-primary);
}

.highlight-heading {
  animation: highlightPulse 2s ease-out;
  border-left: 4px solid var(--cyan-primary);
  padding-left: 8px;
}

@keyframes highlightPulse {
  0% { background-color: rgba(0, 180, 216, 0.3); }
  100% { background-color: transparent; }
}

/* ==========================================================================
   Toast Notifications
   ========================================================================== */

.toast-container {
  position: fixed;
  top: 68px;
  right: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  z-index: 100;
  pointer-events: none;
}

.toast {
  pointer-events: auto;
  min-width: 280px;
  max-width: 420px;
  background-color: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.82rem;
  color: var(--text-primary);
  animation: slideIn 0.2s ease-out;
}

.toast-success { border-left: 4px solid var(--status-green); }
.toast-warning { border-left: 4px solid var(--status-yellow); }
.toast-error { border-left: 4px solid var(--status-red); }
.toast-info { border-left: 4px solid var(--cyan-primary); }

@keyframes slideIn {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* Utility &amp; Icons */
.hidden { display: none !important; }

.btn-icon {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  padding: 4px;
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon:hover {
  color: var(--text-primary);
  background-color: var(--bg-card);
}

.btn-sm {
  font-size: 0.76rem;
  padding: 4px 10px;
  border-radius: var(--radius-xs);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
}

.btn-primary {
  background-color: var(--cyan-primary);
  color: #0b0f17;
  font-weight: 700;
  border: none;
}

.btn-primary:hover { background-color: var(--cyan-hover); }

.btn-secondary {
  background-color: var(--bg-card);
  color: var(--text-primary);
  border: 1px solid var(--border-medium);
}

.btn-secondary:hover { background-color: var(--bg-card-hover); }

.btn-text {
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
}

.btn-text:hover { color: var(--text-primary); }

.svg-icon { width: 20px; height: 20px; fill: currentColor; }
.svg-icon-tab { width: 16px; height: 16px; fill: currentColor; }
.svg-icon-sm { width: 16px; height: 16px; fill: currentColor; }
.svg-icon-xs { width: 14px; height: 14px; fill: currentColor; }

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Responsive Rules */
@media (max-width: 768px) {
  .sidebar {
    position: absolute;
    top: 56px;
    bottom: 0;
    left: 0;
    box-shadow: var(--shadow-lg);
  }
  .sidebar.collapsed {
    transform: translateX(-100%);
  }
  .filter-bar {
    flex-wrap: wrap;
    gap: 8px;
  }
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}
