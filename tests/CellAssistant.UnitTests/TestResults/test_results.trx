[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         resetChat() {
[xUnit.net 00:00:01.08]           const container = document.getElementById('messagesContainer');
[xUnit.net 00:00:01.08]           container.innerHTML = `
[xUnit.net 00:00:01.08]             &lt;div id="emptyState" class="empty-state"&gt;
[xUnit.net 00:00:01.08]               &lt;div class="empty-state-icon"&gt;
[xUnit.net 00:00:01.08]                 &lt;svg viewBox="0 0 24 24" class="svg-icon-hero"&gt;&lt;path d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z"/&gt;&lt;/svg&gt;
