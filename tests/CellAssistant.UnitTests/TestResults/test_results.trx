[xUnit.net 00:00:01.07]           escaped = escaped.replace(/^## (.*$)/gim, '&lt;h2 id="sec-$1"&gt;$1&lt;/h2&gt;');
[xUnit.net 00:00:01.07]           escaped = escaped.replace(/^# (.*$)/gim, '&lt;h1 id="sec-$1"&gt;$1&lt;/h1&gt;');
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]           // Step 5: Bold and Italics
[xUnit.net 00:00:01.07]           escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '&lt;strong&gt;$1&lt;/strong&gt;');
[xUnit.net 00:00:01.07]           escaped = escaped.replace(/\*([^*]+)\*/g, '&lt;em&gt;$1&lt;/em&gt;');
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]           // Step 6: Simple Markdown Tables (| a | b |)
[xUnit.net 00:00:01.07]           const tableRegex = /((?:\|[^\n]+\|\r?\n)+)/g;
[xUnit.net 00:00:01.07]           escaped = escaped.replace(tableRegex, (match) =&gt; {
