[xUnit.net 00:00:01.08]           document.getElementById('tabChat').addEventListener('click', () =&gt; this.switchTab('chat'));
[xUnit.net 00:00:01.08]           document.getElementById('tabAdmin').addEventListener('click', () =&gt; this.switchTab('admin'));
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Sidebar Toggle
[xUnit.net 00:00:01.08]           document.getElementById('sidebarToggleBtn').addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]             document.getElementById('historySidebar').classList.toggle('collapsed');
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // New Chat
[xUnit.net 00:00:01.08]           document.getElementById('newChatBtn').addEventListener('click', () =&gt; this.resetChat());
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Filters
[xUnit.net 00:00:01.08]           const eqSelect = document.getElementById('equipmentFilter');
[xUnit.net 00:00:01.08]           const folderSelect = document.getElementById('folderFilter');
[xUnit.net 00:00:01.08]           eqSelect.addEventListener('change', (e) =&gt; { this.state.equipmentFilter = e.target.value; });
[xUnit.net 00:00:01.08]           folderSelect.addEventListener('change', (e) =&gt; { this.state.folderFilter = e.target.value; });
[xUnit.net 00:00:01.08]           document.getElementById('clearFiltersBtn').addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]             eqSelect.value = '';
[xUnit.net 00:00:01.08]             folderSelect.value = '';
[xUnit.net 00:00:01.08]             this.state.equipmentFilter = '';
[xUnit.net 00:00:01.08]             this.state.folderFilter = '';
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Prompt Chips
[xUnit.net 00:00:01.08]           document.querySelectorAll('.chip').forEach(chip =&gt; {
[xUnit.net 00:00:01.08]             chip.addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]               const q = chip.getAttribute('data-query');
[xUnit.net 00:00:01.08]               if (q) {
[xUnit.net 00:00:01.08]                 document.getElementById('queryInput').value = q;
[xUnit.net 00:00:01.08]                 this.submitQuery();
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]             });
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Input auto-resize and Enter submit
[xUnit.net 00:00:01.08]           const textarea = document.getElementById('queryInput');
[xUnit.net 00:00:01.08]           const counter = document.getElementById('charCounter');
[xUnit.net 00:00:01.08]           textarea.addEventListener('input', () =&gt; {
[xUnit.net 00:00:01.08]             textarea.style.height = 'auto';
[xUnit.net 00:00:01.08]             textarea.style.height = Math.min(textarea.scrollHeight, 180) + 'px';
[xUnit.net 00:00:01.08]             counter.textContent = `${textarea.value.length} / 2000`;
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           textarea.addEventListener('keydown', (e) =&gt; {
[xUnit.net 00:00:01.08]             if (e.key === 'Enter' &amp;&amp; !e.shiftKey) {
[xUnit.net 00:00:01.08]               e.preventDefault();
[xUnit.net 00:00:01.08]               this.submitQuery();
[xUnit.net 00:00:01.08]             }
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Form submit
[xUnit.net 00:00:01.08]           document.getElementById('queryForm').addEventListener('submit', (e) =&gt; {
[xUnit.net 00:00:01.08]             e.preventDefault();
[xUnit.net 00:00:01.08]             this.submitQuery();
[xUnit.net 00:00:01.08]           });
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Stop Stream Button
[xUnit.net 00:00:01.08]           document.getElementById('stopStreamBtn').addEventListener('click', () =&gt; {
[xUnit.net 00:00:01.08]             if (this.state.abortController) {
[xUnit.net 00:00:01.08]               this.state.abortController.abort();
[xUnit.net 00:00:01.08]             }
