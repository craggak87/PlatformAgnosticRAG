[xUnit.net 00:00:01.08]         // Triggers manual reindex via POST /api/admin/reindex
[xUnit.net 00:00:01.08]         async triggerReindex() {
[xUnit.net 00:00:01.08]           const btn = document.getElementById('reindexBtn');
[xUnit.net 00:00:01.08]           const btnText = document.getElementById('reindexBtnText');
[xUnit.net 00:00:01.08]           const icon = document.getElementById('reindexIcon');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           btn.disabled = true;
[xUnit.net 00:00:01.08]           icon.classList.add('spin');
[xUnit.net 00:00:01.08]           btnText.textContent = 'Reindexing in progress...';
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           try {
[xUnit.net 00:00:01.08]             const res = await ApiClient.triggerReindex();
[xUnit.net 00:00:01.08]             Toast.show('Vault reindex initiated! Reconciling SHA-256 hashes...', 'info', 5000);
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]             // Fast polling until indexer returns to idle
[xUnit.net 00:00:01.08]             let pollAttempts = 0;
[xUnit.net 00:00:01.08]             const pollInterval = setInterval(async () =&gt; {
[xUnit.net 00:00:01.08]               pollAttempts++;
[xUnit.net 00:00:01.08]               const health = await ApiClient.getHealth();
[xUnit.net 00:00:01.08]               const indexerStatus = health.data.indexer || (health.data.components &amp;&amp; health.data.components.indexer ? health.data.components.indexer.status : '');
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]               if (indexerStatus.toLowerCase() === 'idle' || indexerStatus.toLowerCase() === 'healthy' || pollAttempts &gt; 15) {
[xUnit.net 00:00:01.08]                 clearInterval(pollInterval);
[xUnit.net 00:00:01.08]                 btn.disabled = false;
[xUnit.net 00:00:01.08]                 icon.classList.remove('spin');
[xUnit.net 00:00:01.08]                 btnText.textContent = 'Trigger Vault Reindex';
[xUnit.net 00:00:01.08]                 Toast.show('Knowledge vault reindex complete! Vectors and metadata synchronized.', 'success', 5000);
[xUnit.net 00:00:01.08]                 this.loadAdminMetrics();
[xUnit.net 00:00:01.08]               }
[xUnit.net 00:00:01.08]             }, 1500);
[xUnit.net 00:00:01.08]           } catch (err) {
[xUnit.net 00:00:01.08]             btn.disabled = false;
[xUnit.net 00:00:01.08]             icon.classList.remove('spin');
[xUnit.net 00:00:01.08]             btnText.textContent = 'Trigger Vault Reindex';
[xUnit.net 00:00:01.08]             Toast.show('Reindex failed: ' + err.message, 'error');
[xUnit.net 00:00:01.08]           }
[xUnit.net 00:00:01.08]         },
