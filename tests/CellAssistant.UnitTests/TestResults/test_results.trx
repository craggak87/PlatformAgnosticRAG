[xUnit.net 00:00:01.07]         },
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]         async getHistory(limit = 20) {
[xUnit.net 00:00:01.07]           const res = await fetch(`/api/history?limit=${limit}`);
[xUnit.net 00:00:01.07]           if (!res.ok) throw new Error(`History fetch failed: HTTP ${res.status}`);
[xUnit.net 00:00:01.07]           return await res.json();
[xUnit.net 00:00:01.07]         },
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]         async getHealth() {
[xUnit.net 00:00:01.07]           const res = await fetch('/api/health');
[xUnit.net 00:00:01.07]           return {
[xUnit.net 00:00:01.07]             status: res.status,
[xUnit.net 00:00:01.07]             data: await res.json()
[xUnit.net 00:00:01.07]           };
[xUnit.net 00:00:01.07]         },
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]         async triggerReindex() {
[xUnit.net 00:00:01.07]           const res = await fetch('/api/admin/reindex', {
[xUnit.net 00:00:01.07]             method: 'POST',
[xUnit.net 00:00:01.07]             headers: { 'Content-Type': 'application/json' }
[xUnit.net 00:00:01.07]           });
[xUnit.net 00:00:01.07]           if (!res.ok) throw new Error(`Reindex failed: HTTP ${res.status}`);
[xUnit.net 00:00:01.07]           return await res.json();
[xUnit.net 00:00:01.07]         },
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]         async getDocumentFile(documentId) {
[xUnit.net 00:00:01.07]           const res = await fetch(`/api/documents/${documentId}/file`);
[xUnit.net 00:00:01.07]           if (!res.ok) {
[xUnit.net 00:00:01.07]             if (res.status === 403) throw new Error('Access forbidden: path outside vault root.');
[xUnit.net 00:00:01.07]             if (res.status === 404) throw new Error('Document not found in knowledge vault.');
[xUnit.net 00:00:01.07]             throw new Error(`File retrieval failed (HTTP ${res.status})`);
[xUnit.net 00:00:01.07]           }
[xUnit.net 00:00:01.07]           const contentType = res.headers.get('content-type') || '';
[xUnit.net 00:00:01.07]           if (contentType.includes('application/pdf')) {
[xUnit.net 00:00:01.07]             return { isPdf: true, url: `/api/documents/${documentId}/file` };
[xUnit.net 00:00:01.07]           }
[xUnit.net 00:00:01.07]           const text = await res.text();
[xUnit.net 00:00:01.07]           return { isPdf: false, text, url: `/api/documents/${documentId}/file` };
[xUnit.net 00:00:01.07]         }
[xUnit.net 00:00:01.07]       };
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]       // ============================================================================
[xUnit.net 00:00:01.07]       // 4. UI Manager / State Machine
[xUnit.net 00:00:01.07]       // ============================================================================
[xUnit.net 00:00:01.07]       const App = {
[xUnit.net 00:00:01.07]         state: {
[xUnit.net 00:00:01.07]           currentTab: 'chat',
[xUnit.net 00:00:01.07]           isStreaming: false,
[xUnit.net 00:00:01.07]           abortController: null,
[xUnit.net 00:00:01.07]           pollTimer: null,
[xUnit.net 00:00:01.07]           equipmentFilter: '',
[xUnit.net 00:00:01.07]           folderFilter: ''
[xUnit.net 00:00:01.07]         },
[xUnit.net 00:00:01.07]       
[xUnit.net 00:00:01.07]         init() {
[xUnit.net 00:00:01.08]           this.bindDomEvents();
[xUnit.net 00:00:01.08]           this.loadSearchHistory();
[xUnit.net 00:00:01.08]           this.checkHealth();
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]           // Start background health polling every 10 seconds
[xUnit.net 00:00:01.08]           setInterval(() =&gt; this.checkHealth(), 10000);
[xUnit.net 00:00:01.08]         },
[xUnit.net 00:00:01.08]       
[xUnit.net 00:00:01.08]         bindDomEvents() {
