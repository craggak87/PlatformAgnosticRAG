# ==============================================================================
# Cell Knowledge Assistant - Environment Variable Configuration Template
# Overrides settings in config/config.yaml per Doc 6 §6
# ==============================================================================

# REST API Server Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Local Ollama LLM & Embedding Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:e4b-it-q4_K_M
OLLAMA_FALLBACK_CHAT_MODEL=qwen3.8:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:latest

# Local Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=cell-knowledge
QDRANT_VECTOR_SIZE=768

# Knowledge Base Vault & SQLite Document Registry
KNOWLEDGE_BASE_ROOT_PATH=./sample-data/KnowledgeBase
KNOWLEDGE_BASE_SQLITE_PATH=./data/metadata.db
