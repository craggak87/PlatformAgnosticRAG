{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "environment": "Development"
  },
  "ollama": {
    "baseUrl": "http://localhost:11434",
    "requestTimeoutSeconds": 120,
    "embeddingModel": "embeddinggemma-2:latest",
    "primaryChatModel": "gemma4:e4b-it-q4_K_M",
    "fallbackChatModel": "qwen3.8:latest"
  },
  "qdrant": {
    "host": "localhost",
    "grpcPort": 6334,
    "collectionName": "cell-knowledge"
  },
  "knowledgeBase": {
    "rootPath": "./sample-data/KnowledgeBase",
    "sqlitePath": "./data/metadata.db",
    "maxChunkWords": 500,
    "chunkOverlapWords": 100,
    "watcherDebounceMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
